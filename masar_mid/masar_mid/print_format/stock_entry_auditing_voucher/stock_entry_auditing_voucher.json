 "html": "{% set gl = frappe.get_list(doctype=\"GL Entry\",  fields=[\"account\", \"party_type\", \"party\", \"debit\", \"credit\", \"project\", \"budget_element\", \"cost_center\"], filters={\"voucher_type\": doc.doctype, \"voucher_no\": doc.name}) %}\n<div class=\"page-break\">\n    <div class=\"print-heading\">\n        <h2>Stock Entry<br>\n            <small>{{doc.name}}</small>\n        </h2>\n    </div>\n    <div class=\"row section-break\">\n        <div class=\"col-xs-6 column-break\">\n            <div class=\"row\">\n                <div class=\"col-xs-5 text-right\">\n                    <label>Stock Entry Type:</label>\n                </div>\n                <div class=\"col-xs-7 value\">\n                    {{doc.stock_entry_type}}\n                </div>\n            </div>\n        </div>\n\n        <div class=\"col-xs-6 column-break\">\n            <div class=\"row\">\n                <div class=\"col-xs-5 text-right\">\n                    <label>Posting Date:</label>\n                </div>\n                <div class=\"col-xs-7 value\">\n                    {{frappe.utils.formatdate(doc.posting_date)}}\n                </div>\n            </div>\n        </div>\n    </div>\n    <div class=\"margin-top\">\n        <table class='table table-bordered table-condensed'>\n            <tr>\n                <th>Sr.</th>\n                <th>Account</th>\n                <th>Debit</th>\n                <th>Credit</th>\n                <th>Budget Element</th>\n                <th>Project</th>\n                <th>Cost Center</th>\n            </tr>\n            {% for entries in gl %}\n            <tr>\n                <td>{{ loop.index }}</td>\n                <td>{{ entries.account }}</td>\n                <td>{{ entries.debit }}</td>\n                <td>{{ entries.credit }}</td>\n                <td>{{ entries.budget_element }}</td>\n                <td>{{ entries.project }}</td>\n                <td>{{ entries.cost_center }}</td>\n            </tr>\n            {% endfor %}\n        </table>\n    </div>\n</div>",
